# 凭证与本地环境
.env.local
.env
.venv/
.venv-avatar/

# 运行日志与临时文件
*.log
nohup.out
logs/
__pycache__/
*.pyc

# 第三方推理代码与模型权重（部署脚本拉取）
vendor/
models/

# 用户提供的音色素材（个人材料，不入库）
assets/*/ref.wav
assets/*/ref.txt
assets/*/ref.png
assets/*/ref.jpg
# 音色衍生物（TTS 克隆生成的嘟囔/垫音，同上不入库）
assets/*/murmur_*.wav
assets/*/fillers/**/*.wav

# 局域网反代的自签证书与私钥（可重新生成，不入库）
scripts/lan_https/*.crt
scripts/lan_https/*.key
scripts/lan_https/*.csr
scripts/lan_https/*.srl

# macOS / 测试缓存
.DS_Store
.pytest_cache/
