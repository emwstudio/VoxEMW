# ---- DeepSeek API key（必填）----
# configs/assistant.yaml 里 llm.api_key_env 指向这个名字；管线从环境读取。
# 控制台：https://platform.deepseek.com/ → API keys
DEEPSEEK_API_KEY=sk-your-key-here

# ---- Hugging Face token（下载模型一般用不到，可选）----
# HF_TOKEN=

# ---- 可选：配置路径（默认 configs/assistant.yaml）----
# VOXEMW_CONFIG=configs/assistant.yaml
