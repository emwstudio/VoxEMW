# ---- LLM API key（必填）----
# configs/assistant.yaml 里 llm.api_key_env 指向这个名字；管线从环境读取
# （兜底变量名 LLM_API_KEY），缺失会直接报错。
# DeepSeek key 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=

# ---- Kimi 多模态 API key（可选，摄像头截帧打分功能用）----
# configs/assistant.yaml 里 vision.api_key_env 指向这个名字；
# 不填则截帧功能自动关闭，语音对话不受影响。key 在 https://platform.moonshot.cn 申请
KIMI_API_KEY=

# ---- Hugging Face token（服务器上下载模型用，可选）----
# HF_TOKEN=

# ---- 可选：配置路径（默认 configs/assistant.yaml）----
# VOXEMW_CONFIG=configs/assistant.yaml
