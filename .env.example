# ---- LLM API key（必填）----
# configs/autodl-4090.yaml 里 llm.api_key_env 指向这个名字；launch.py 从环境读取，
# 缺失会直接报错。默认配置用 DeepSeek：https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=

# ---- 可选：音色克隆素材覆盖 ----
# 默认走 configs/autodl-4090.yaml 的 tts.ref_audio/ref_text（assets/liangzi/）。
# 想换音色，改 YAML 里的路径即可；这里的环境变量供你自己写的配置引用。
# 素材要求：ref.wav 10-30s 清晰单人声（无背景音/音乐），ref.txt 为其逐字台词。
# TTS_REF_WAV=assets/fengge/ref.wav
# TTS_REF_TEXT=assets/fengge/ref.txt

# ---- 可选：积木配置路径（默认 configs/autodl-4090.yaml）----
# S2S_CONFIG=configs/autodl-4090.yaml
