+# OmniVoice TTS handler 的 CLI 参数类（--tts omnivoice 时生效）。
+# 由 patches/register-handlers.patch 创建；改动需同步更新 patch。
+
+from dataclasses import dataclass, field
+from typing import Optional
+
+
+@dataclass
+class OmniVoiceTTSHandlerArguments:
+    omnivoice_tts_model_name: str = field(
+        default="k2-fsa/OmniVoice",
+        metadata={"help": "The OmniVoice model to use (HuggingFace Hub ID or local path). Default is 'k2-fsa/OmniVoice'."},
+    )
+    omnivoice_tts_device: str = field(
+        default="cuda:0",
+        metadata={"help": "Device map for OmniVoice inference. Default is 'cuda:0'."},
+    )
+    omnivoice_tts_dtype: str = field(
+        default="float16",
+        metadata={
+            "help": "Data type for inference. Options: 'float16', 'bfloat16', 'float32'. Default is 'float16'."
+        },
+    )
+    omnivoice_tts_ref_audio: Optional[str] = field(
+        default=None,
+        metadata={
+            "help": "Optional path to reference audio file for voice cloning. When set, a voice-clone prompt "
+            "is pre-encoded at startup (cached on disk). Default is None."
+        },
+    )
+    omnivoice_tts_ref_text: Optional[str] = field(
+        default=None,
+        metadata={
+            "help": "Transcription of the reference audio. Optional; when omitted OmniVoice runs its built-in "
+            "Whisper ASR on the reference audio. Default is None."
+        },
+    )
+    omnivoice_tts_voices: Optional[str] = field(
+        default=None,
+        metadata={
+            "help": "Optional JSON object of extra hot-switchable voices: "
+            "'{\"name\": {\"ref_audio\": \"...\", \"ref_text\": \"...\"}}'. Each voice is "
+            "pre-encoded at startup (same disk cache as ref_audio) and selected at runtime via "
+            "session.audio.output.voice. Default is None."
+        },
+    )
+    omnivoice_tts_prompt_cache_dir: str = field(
+        default="./omnivoice_prompts",
+        metadata={
+            "help": "Directory where the encoded voice-clone prompt (.pt) is cached. Default is './omnivoice_prompts'."
+        },
+    )
+    omnivoice_tts_sample_rate: int = field(
+        default=16000,
+        metadata={
+            "help": "Output sample rate in Hz. OmniVoice generates at 24kHz and is resampled to this rate. "
+            "Default is 16000 to match the pipeline's audio streamer."
+        },
+    )
+    omnivoice_tts_blocksize: int = field(
+        default=512,
+        metadata={
+            "help": "Audio chunk size in samples for streaming output. Must match LocalAudioStreamer blocksize. Default is 512."
+        },
+    )
+    omnivoice_tts_language: Optional[str] = field(
+        default=None,
+        metadata={
+            "help": "Language hint passed to OmniVoice.generate (e.g. 'Chinese'). The docs note quality is "
+            "slightly better than language-agnostic mode when set. Default is None (agnostic)."
+        },
+    )
