+# VoxCPM TTS handler 的 CLI 参数类（--tts voxcpm 时生效）。
+# 由 patches/register-handlers.patch 创建；改动需同步更新 patch。
+
+from dataclasses import dataclass, field
+from typing import Optional
+
+
+@dataclass
+class VoxCPMTTSHandlerArguments:
+    voxcpm_tts_model_name: str = field(
+        default="openbmb/VoxCPM2",
+        metadata={"help": "The VoxCPM model to use (HuggingFace Hub ID or local path). Default is 'openbmb/VoxCPM2'."},
+    )
+    voxcpm_tts_device: str = field(
+        default="cuda:0",
+        metadata={"help": "Device for VoxCPM inference (e.g. 'cuda:0', 'cuda', 'cpu'). Default is 'cuda:0'."},
+    )
+    voxcpm_tts_ref_audio: Optional[str] = field(
+        default=None,
+        metadata={
+            "help": "Path to reference audio for voice cloning (default voice). With ref_text set, "
+            "Ultimate Cloning is used (audio passed as both continuation prompt and reference). "
+            "Default is None."
+        },
+    )
+    voxcpm_tts_ref_text: Optional[str] = field(
+        default=None,
+        metadata={
+            "help": "Exact transcript of the reference audio, enabling Ultimate Cloning. "
+            "When omitted, falls back to reference-only cloning. Default is None."
+        },
+    )
+    voxcpm_tts_voices: Optional[str] = field(
+        default=None,
+        metadata={
+            "help": "Optional JSON object of extra hot-switchable voices: "
+            "'{\"name\": {\"ref_audio\": \"...\", \"ref_text\": \"...\"}}'. Each voice's prompt cache is "
+            "pre-built at startup and selected at runtime via session.audio.output.voice. Default is None."
+        },
+    )
+    voxcpm_tts_sample_rate: int = field(
+        default=16000,
+        metadata={
+            "help": "Output sample rate in Hz. VoxCPM2 generates at 48kHz and is resampled to this rate. "
+            "Default is 16000 to match the pipeline's audio streamer."
+        },
+    )
+    voxcpm_tts_blocksize: int = field(
+        default=512,
+        metadata={
+            "help": "Audio chunk size in samples for streaming output. Must match LocalAudioStreamer blocksize. Default is 512."
+        },
+    )
+    voxcpm_tts_cfg_value: float = field(
+        default=2.0,
+        metadata={"help": "Classifier-free guidance scale for generation. Default is 2.0."},
+    )
+    voxcpm_tts_inference_timesteps: int = field(
+        default=10,
